{
  "name": "@botmem/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --maxWorkers=1 --exclude \"mcp/*.e2e.test.ts\" && vitest run mcp/oauth-pkce.e2e.test.ts --maxWorkers=1 && vitest run mcp/session-lifecycle.e2e.test.ts --maxWorkers=1 && vitest run mcp/tools.e2e.test.ts --maxWorkers=1 && vitest run --config people/vitest.config.ts --maxWorkers=1",
    "test:auth": "vitest run --dir auth",
    "test:connectors": "vitest run --dir connectors",
    "test:people": "vitest run --config people/vitest.config.ts",
    "test:search": "vitest run --dir search",
    "test:ui": "playwright test --workers=1",
    "test:cli": "vitest run --dir cli",
    "test:mcp": "vitest run --dir mcp",
    "test:user": "vitest run --dir user"
  },
  "devDependencies": {
    "@botmem/shared": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.16.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/supertest": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.1.0",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.11",
    "vitest": "catalog:"
  }
}
