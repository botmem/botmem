{
  "name": "botmem-v2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "package:cli": "./scripts/package-cli.sh",
    "typecheck": "pnpm --filter @botmem-v2/contracts build && pnpm -r --if-present typecheck",
    "test": "pnpm build && pnpm test:packages",
    "test:packages": "pnpm -r --if-present test",
    "test:coverage": "pnpm build && pnpm -r --if-present test:coverage",
    "verify": "pnpm typecheck && pnpm build && pnpm test:packages",
    "verify:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "test:production-e2e": "./scripts/production-e2e.sh",
    "test:web-render": "./scripts/web-render-smoke.sh",
    "check": "pnpm verify && pnpm verify:rust"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
