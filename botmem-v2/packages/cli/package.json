  },
  "dependencies": {
    "@botmem-v2/contracts": "workspace:*",
    "@botmem-v2/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
