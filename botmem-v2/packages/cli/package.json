{
  "name": "@botmem-v2/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "botmem": "./dist/bin.js",
    "botmem-v2": "./dist/bin.js"
  },
  "scripts": {
