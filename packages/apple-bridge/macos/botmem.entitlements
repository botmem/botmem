<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Contacts: the node child reads Contacts when that source is selected.
       TCC attributes the access to this signed app, so the entitlement +
       NSContactsUsageDescription must live here. -->
  <key>com.apple.security.personal-information.addressbook</key>
  <true/>
  <!-- Node spawned as a child runs JS via V8 JIT; under the hardened runtime
       these are required or the child crashes on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Allow loading the bundled better-sqlite3 native .node addon, which may
       not be signed by the same Team ID as the app. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
