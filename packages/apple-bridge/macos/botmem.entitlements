<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Contacts: the in-process engine reads Contacts when that source is
       selected. TCC attributes the access to this signed app, so the entitlement
       + NSContactsUsageDescription must live here. -->
  <key>com.apple.security.personal-information.addressbook</key>
  <true/>
  <!-- NOTE: the V8-JIT / unsigned-executable-memory / disable-library-validation
       exceptions were only needed by the old bundled Node child (and its native
       better-sqlite3 addon). The engine is now Rust statically linked into the
       app binary, so none of those are required. -->
</dict>
</plist>
