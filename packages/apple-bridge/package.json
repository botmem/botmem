{
  "name": "@botmem/apple-bridge",
  "version": "0.0.0",
  "description": "Apple bridge for Botmem — reads local Contacts and iMessages through an encrypted WebSocket tunnel",
  "type": "module",
  "bin": {
    "apple-bridge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:mac-app": "node scripts/build-macos-app.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^5.7.0",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.6"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
