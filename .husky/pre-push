#!/usr/bin/env sh

# 1. Run typecheck and unit tests (excludes e2e — those need a running server)
if git rev-parse --verify origin/main >/dev/null 2>&1; then
  pnpm turbo typecheck test --filter='...[origin/main...HEAD]' --filter='!@botmem/e2e'
else
  pnpm turbo typecheck test --filter='!@botmem/e2e'
fi

# 2. Confirm the CLI publish path. The CLI build runs the skill response-type generator first.
pnpm --filter @botmem/cli build
pnpm --filter @botmem/cli test

# 3. Confirm web coverage thresholds before CI.
pnpm --filter @botmem/web test:coverage

# 4. Run e2e tests. The API server must already be running on localhost:12412.
if curl -sf http://localhost:12412/api/version > /dev/null 2>&1; then
  echo "API server detected - running e2e tests..."
  pnpm test:e2e
  pnpm test:e2e:ui --reporter=line
else
  echo "API server not running - start it with 'pnpm dev' or 'pnpm --filter @botmem/api start' before pushing."
  exit 1
fi
