{
  "name": "@botmem/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:standalone": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node prerender.mjs",
    "build:app": "VITE_WEB_SURFACE=app pnpm build",
    "build:landing": "VITE_WEB_SURFACE=landing pnpm build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@botmem/shared": "workspace:*",
    "driver.js": "^1.4.0",
    "firebase": "^12.13.0",
    "posthog-js": "^1.376.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-force-graph-2d": "^1.29.1",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
